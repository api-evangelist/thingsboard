          "name": "Get OAuth2 Clients (getOAuth2Clients)",
          "request": {
            "name": "Get OAuth2 Clients (getOAuth2Clients)",
            "description": {
              "content": "Get the list of OAuth2 clients to log in with, available for such domain scheme (HTTP or HTTPS) (if x-forwarded-proto request header is present - the scheme is known from it) and domain name and port (port may be known from x-forwarded-port header)",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "noauth",
                "oauth2Clients"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "pkgName",
                  "value": "<string>",
                  "description": "Mobile application package name, to find OAuth2 clients where there is configured mobile application with such package name"
                },
                {
                  "disabled": false,
                  "key": "platform",
                  "value": "<string>",
                  "description": "Platform type to search OAuth2 clients for which the usage with this platform type is allowed in the settings. If platform type is not one of allowable values - it will just be ignored"
