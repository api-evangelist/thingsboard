              "body": "{\n  \"minVerificationCodeSendPeriod\": 7943,\n  \"providers\": [\n    {\n      \"providerType\": \"string\",\n      \"codesQuantity\": 3675\n    },\n    {\n      \"providerType\": \"string\",\n      \"codesQuantity\": 3057\n    }\n  ],\n  \"totalAllowedTimeForVerification\": 6223,\n  \"verificationCodeCheckRateLimit\": \"76849632:802933\",\n  \"maxVerificationFailuresBeforeUserLockout\": 6085,\n  \"enforceTwoFa\": false,\n  \"enforcedUsersFilter\": {}\n}",
              "cookie": [],
