        {
          "id": "b0110c29-e3db-4e57-8752-4bbdb3825531",
          "name": "Activate User",
          "request": {
            "name": "Activate User",
            "description": {
              "content": "Checks the activation token and updates corresponding user password in the database. Now the user may start using his password to login. The response already contains the [JWT](https://jwt.io) activation and refresh tokens, to simplify the user activation flow and avoid asking user to input password again after activation. If token is valid, returns the object that contains [JWT](https://jwt.io/) access and refresh tokens. If token is not valid, returns '400 Bad Request'.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "noauth",
                "activate"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "sendActivationMail",
                  "value": "true"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
