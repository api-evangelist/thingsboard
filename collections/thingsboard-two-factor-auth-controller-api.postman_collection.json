          "name": "Get Available 2FA Providers (getAvailableTwoFaProviders)",
          "request": {
            "name": "Get Available 2FA Providers (getAvailableTwoFaProviders)",
            "description": {
              "content": "Get the list of 2FA provider infos available for user to use. Example:\n```\n[\n  {\n    \"type\": \"EMAIL\",\n    \"default\": true,\n    \"contact\": \"ab*****ko@gmail.com\"\n  },\n  {\n    \"type\": \"TOTP\",\n    \"default\": false,\n    \"contact\": null\n  },\n  {\n    \"type\": \"SMS\",\n    \"default\": false,\n    \"contact\": \"+38********12\"\n  }\n]\n```",
              "type": "text/plain"
