          "name": "Save or Update Mobile App (saveMobileApp)",
          "request": {
            "name": "Save or Update Mobile App (saveMobileApp)",
            "description": {
              "content": "Create or update the Mobile app. When creating mobile app, platform generates Mobile App Id as [time-based UUID](https://en.wikipedia.org/wiki/Universally_unique_identifier#Version_1_(date-time_and_MAC_address)). The newly created Mobile App Id will be present in the response. Specify existing Mobile App Id to update the mobile app. Referencing non-existing Mobile App Id will cause 'Not Found' error.\n\nThe pair of mobile app package name and platform type is unique for entire platform setup.\n\n\n\nAvailable for users with 'SYS_ADMIN' or 'TENANT_ADMIN' authority.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "mobile",
                "app"
              ],
