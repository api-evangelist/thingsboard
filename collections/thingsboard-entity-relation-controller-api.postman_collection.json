              "mode": "raw",
              "raw": "{\n  \"from\": {\n    \"entityType\": \"<string>\",\n    \"id\": \"<uuid>\"\n  },\n  \"to\": {\n    \"entityType\": \"<string>\",\n    \"id\": \"<uuid>\"\n  },\n  \"type\": \"<string>\",\n  \"typeGroup\": \"<string>\",\n  \"version\": \"<long>\",\n  \"additionalInfo\": {}\n}",
