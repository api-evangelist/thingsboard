                      "raw": "{\n  \"configuration\": {\n    \"channelName\": \"<string>\",\n    \"type\": \"<string>\",\n    \"webhookUrl\": \"<string>\",\n    \"description\": \"<string>\",\n    \"useOldApi\": \"<boolean>\",\n    \"id\": {},\n    \"title\": \"<string>\",\n    \"email\": \"<string>\",\n    \"firstName\": \"<string>\",\n    \"lastName\": \"<string>\"\n  },\n  \"name\": \"<string>\",\n  \"id\": {\n    \"entityType\": \"NOTIFICATION_TARGET\",\n    \"id\": \"<uuid>\"\n  },\n  \"createdTime\": \"<long>\",\n  \"tenantId\": {\n    \"entityType\": \"TENANT\",\n    \"id\": \"<uuid>\"\n  }\n}",
