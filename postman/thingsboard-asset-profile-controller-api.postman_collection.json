                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"id\": {\n    \"entityType\": \"ASSET_PROFILE\",\n    \"id\": \"<uuid>\"\n  },\n  \"createdTime\": \"<long>\",\n  \"tenantId\": {\n    \"entityType\": \"TENANT\",\n    \"id\": \"<uuid>\"\n  },\n  \"name\": \"<string>\",\n  \"description\": \"<string>\",\n  \"image\": \"<string>\",\n  \"defaultRuleChainId\": {\n    \"entityType\": \"RULE_CHAIN\",\n    \"id\": \"<uuid>\"\n  },\n  \"defaultDashboardId\": {\n    \"entityType\": \"DASHBOARD\",\n    \"id\": \"<uuid>\"\n  },\n  \"defaultQueueName\": \"<string>\",\n  \"defaultEdgeRuleChainId\": {\n    \"entityType\": \"RULE_CHAIN\",\n    \"id\": \"<uuid>\"\n  },\n  \"version\": \"<long>\",\n  \"default\": \"<boolean>\"\n}",
