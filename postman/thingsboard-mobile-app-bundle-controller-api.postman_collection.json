                      "mode": "raw",
                      "raw": "{\n  \"title\": \"<string>\",\n  \"id\": {\n    \"entityType\": \"CALCULATED_FIELD\",\n    \"id\": \"<uuid>\"\n  },\n  \"createdTime\": \"<long>\",\n  \"tenantId\": {\n    \"entityType\": \"TENANT\",\n    \"id\": \"<uuid>\"\n  },\n  \"description\": \"<string>\",\n  \"androidAppId\": {\n    \"entityType\": \"OAUTH2_CLIENT\",\n    \"id\": \"<uuid>\"\n  },\n  \"iosAppId\": {\n    \"entityType\": \"RULE_NODE\",\n    \"id\": \"<uuid>\"\n  },\n  \"layoutConfig\": {\n    \"pages\": [\n      {\n        \"visible\": \"<boolean>\",\n        \"type\": \"DASHBOARD\",\n        \"path\": \"<string>\",\n        \"label\": \"<string>\",\n        \"icon\": \"<string>\"\n      },\n      {\n        \"visible\": \"<boolean>\",\n        \"type\": \"DASHBOARD\",\n        \"path\": \"<string>\",\n        \"label\": \"<string>\",\n        \"icon\": \"<string>\"\n      }\n    ]\n  },\n  \"oauth2Enabled\": \"<boolean>\",\n  \"name\": \"<string>\"\n}",
