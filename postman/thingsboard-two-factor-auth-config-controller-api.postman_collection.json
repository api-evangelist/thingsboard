                      "raw": "{\n  \"minVerificationCodeSendPeriod\": \"<integer>\",\n  \"providers\": [\n    {\n      \"providerType\": \"<string>\",\n      \"codesQuantity\": \"<integer>\"\n    },\n    {\n      \"providerType\": \"<string>\",\n      \"codesQuantity\": \"<integer>\"\n    }\n  ],\n  \"totalAllowedTimeForVerification\": \"<integer>\",\n  \"verificationCodeCheckRateLimit\": \"2612767:892510161\",\n  \"maxVerificationFailuresBeforeUserLockout\": \"<integer>\",\n  \"enforceTwoFa\": \"<boolean>\",\n  \"enforcedUsersFilter\": {}\n}",
