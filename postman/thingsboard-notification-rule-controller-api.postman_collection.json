                        "value": "application/json"
                      }
                    ],
                    "body": {
                      "mode": "raw",
                      "raw": "{\n  \"name\": \"<string>\",\n  \"recipientsConfig\": {\n    \"escalationTable\": {\n      \"consectetur3_f\": [\n        \"<uuid>\",\n        \"<uuid>\"\n      ]\n    },\n    \"triggerType\": \"EDGE_COMMUNICATION_FAILURE\"\n  },\n  \"templateId\": {\n    \"entityType\": \"NOTIFICATION_TEMPLATE\",\n    \"id\": \"<uuid>\"\n  },\n  \"triggerConfig\": {\n    \"notifyOn\": [\n      \"UNASSIGNED\"\n    ],\n    \"triggerType\": \"TASK_PROCESSING_FAILURE\",\n    \"alarmTypes\": [\n      \"<string>\",\n      \"<string>\"\n    ],\n    \"alarmSeverities\": [\n      \"MINOR\",\n      \"CRITICAL\"\n    ],\n    \"alarmStatuses\": [\n      \"UNACK\",\n      \"ANY\"\n    ]\n  },\n  \"triggerType\": \"ALARM_ASSIGNMENT\",\n  \"id\": {\n    \"entityType\": \"NOTIFICATION_RULE\",\n    \"id\": \"<uuid>\"\n  },\n  \"createdTime\": \"<long>\",\n  \"tenantId\": {\n    \"entityType\": \"TENANT\",\n    \"id\": \"<uuid>\"\n  },\n  \"enabled\": \"<boolean>\",\n  \"additionalConfig\": {\n    \"description\": \"<string>\"\n  }\n}",
                      "options": {
                        "raw": {
                          "headerFamily": "json",
                          "language": "json"
                        }
